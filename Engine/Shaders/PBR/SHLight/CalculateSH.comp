#version 450 core
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_arithmetic: enable
#extension GL_KHR_shader_subgroup_basic: enable

#include "SHCommon.h"

const uint NumSamples = 32 * 32; // 总的Sample数目（32 * 32个Group，每个Group处理32 * 32个线程）
const float InvNumSamples = 1.0 / float(NumSamples);

shared vec3 shufflegroup[32];

layout(push_constant) uniform PushConstants
{
	int ci;
    int BatchIndex;//ci中第几个Dispatch
    int TotalNumSamples; // 一共多少采样点
} pushConstants;

layout(set=0, binding=0) buffer shcBufferBlock{
    vec4 shcBuffer[];
}outBuffer;

layout(set=1, binding=0) uniform samplerCube irradianceTexture;

vec3 calSH(vec3 sampleDirection,uint SHIndex,float invSampleCount)
{
    vec3 irradiance = texture(irradianceTexture, sampleDirection).rgb;

    if(SHIndex == 0)
    {
        return irradiance * GetY00(sampleDirection) * 4 * PI * invSampleCount;
    }
    else if(SHIndex == 1)
    {
        return irradiance * GetY1n1(sampleDirection) * 4 * PI * invSampleCount;
    }
    else if(SHIndex == 2)
    {
        return irradiance * GetY10(sampleDirection) * 4 * PI * invSampleCount;
    }
    else if(SHIndex == 3)
    {    
        return irradiance * GetY1p1(sampleDirection) * 4 * PI * invSampleCount;
    }
    else if(SHIndex == 4)
    {
        return irradiance * GetY2n2(sampleDirection) * 4 * PI * invSampleCount;
    }
    else if(SHIndex == 5)
    {
        return irradiance * GetY2n1(sampleDirection) * 4 * PI * invSampleCount; 
    }
    else if(SHIndex == 6)
    {  
        return irradiance * GetY20(sampleDirection) * 4 * PI * invSampleCount;
    }
    else if(SHIndex == 7)
    {
        return irradiance * GetY2p1(sampleDirection) * 4 * PI * invSampleCount;
    }
    else if(SHIndex == 8)
    {
        return irradiance * GetY2p2(sampleDirection) * 4 * PI * invSampleCount;
    }
}

// 每个Thread只会计算一次，通过组间Reduction来进行归并结果
layout(local_size_x=32, local_size_y=32, local_size_z=1) in;
void main()
{
    if(gl_LocalInvocationIndex == 0 && pushConstants.BatchIndex == 0)
    {    
        outBuffer.shcBuffer[pushConstants.ci] = vec4(0);
    }

    float inv = 1.0 / pushConstants.TotalNumSamples;
    vec2 ij = sampleHammersley(NumSamples * pushConstants.BatchIndex + gl_LocalInvocationIndex , inv);

    vec3 SampleDirection = samplesphere(ij.x,ij.y);

    vec3 Sum =  calSH(SampleDirection,pushConstants.ci,inv);

    //subgroup是一维的，大小就是warp的大小
    Sum = subgroupAdd(Sum);

    if (gl_SubgroupInvocationID == 0)
    {
        shufflegroup[gl_SubgroupID] = Sum;
    }

    memoryBarrierShared();
    barrier();

    if (gl_SubgroupID == 0)
    {
        Sum = shufflegroup[gl_SubgroupInvocationID];
        Sum = subgroupAdd(Sum);
    }

    if(gl_LocalInvocationIndex == 0)
    {    
        outBuffer.shcBuffer[pushConstants.ci] += vec4(Sum,1.0);
    }
}