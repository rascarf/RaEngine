#version 450 core

const float PI = 3.141592;
const float TwoPI = 2 * PI;
const float Epsilon = 0.00001;

const uint NumSamples = 1024;
const float InvNumSamples = 1.0 / float(NumSamples);

layout(constant_id=0) const int NumMipLevels = 1;
layout(set=0, binding=0) uniform samplerCube inputTexture;
layout(set=0, binding=2, rgba16f) restrict writeonly uniform imageCube outputTexture[11]; // TODO SpcializationInfo目前不知道为啥不能用在这里，痛苦

layout(push_constant) uniform PushConstants
{
	int level;
	float roughness;
} pushConstants;

#define PARAM_LEVEL     pushConstants.level
#define PARAM_ROUGHNESS pushConstants.roughness

// 随机且不重复的坐标
float radicalInverse_VdC(uint bits)
{
	bits = (bits << 16u) | (bits >> 16u);
	bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
	bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
	bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
	bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
	return float(bits) * 2.3283064365386963e-10; // / 0x100000000
}

// 采样第i个HammersleySet中的元素
vec2 sampleHammersley(uint i)
{
	return vec2(i * InvNumSamples, radicalInverse_VdC(i));
}

// 根据低差异和粗糙度对ggx采样，得到满足条件的采样光线
// 这里采样出来的光线会偏向lobe，重要性采样
// 逆变采样得到符合GGX分布的向量
vec3 sampleGGX(float u1, float u2, float roughness)
{
    float alpha = roughness * roughness;

	float cosTheta = sqrt((1.0 - u2) / (1.0 + (alpha*alpha - 1.0) * u2));
	float sinTheta = sqrt(1.0 - cosTheta*cosTheta);
	float phi = TwoPI * u1;

    // 转换笛卡尔坐标系
	return vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
}

// 法线分布函数 根据roughness和半程向量得到pdf : Trowbridge-Reitz GGX
// 本来就可以作为PDF使用（我觉得按理说应该去使用ggx的pdf
// cosLh:N * H：N是平面法线 H是期望的半程向量，roughness：粗糙度
// 返回值：float 代表H这条光线的概率密度
float ndfGGX(float cosLh, float roughness)
{
	float alpha   = roughness * roughness;
	float alphaSq = alpha * alpha;

	float denom = (cosLh * cosLh) * (alphaSq - 1.0) + 1.0;
	return alphaSq / (PI * denom * denom);
}

// 详细解释可以看equirect2Cube
vec3 getSamplingVector()
{
    vec2 st = gl_GlobalInvocationID.xy/vec2(imageSize(outputTexture[PARAM_LEVEL]));
    vec2 uv = 2.0 * vec2(st.x, 1.0-st.y) - vec2(1.0);

    vec3 ret;
    // Sadly 'switch' doesn't seem to work, at least on NVIDIA.
    if(gl_GlobalInvocationID.z == 0)      ret = vec3(1.0,  uv.y, -uv.x);
    else if(gl_GlobalInvocationID.z == 1) ret = vec3(-1.0, uv.y,  uv.x);
    else if(gl_GlobalInvocationID.z == 2) ret = vec3(uv.x, 1.0, -uv.y);
    else if(gl_GlobalInvocationID.z == 3) ret = vec3(uv.x, -1.0, uv.y);
    else if(gl_GlobalInvocationID.z == 4) ret = vec3(uv.x, uv.y, 1.0);
    else if(gl_GlobalInvocationID.z == 5) ret = vec3(-uv.x, uv.y, -1.0);
    return normalize(ret);
}

// TBN到世界空间，因为实际上要采样CubeMap
void computeBasisVectors(const vec3 N, out vec3 S, out vec3 T)
{
	T = cross(N, vec3(0.0, 1.0, 0.0));
	T = mix(cross(N, vec3(1.0, 0.0, 0.0)), T, step(Epsilon, dot(T, T)));

	T = normalize(T);
	S = normalize(cross(N, T));
}

vec3 tangentToWorld(const vec3 v, const vec3 N, const vec3 S, const vec3 T)
{
	return S * v.x + T * v.y + N * v.z;
}

layout(local_size_x=32, local_size_y=32, local_size_z=1) in;
void main(void)
{
    // 确保不越界
    ivec2 outputSize = imageSize(outputTexture[PARAM_LEVEL]);
	if(gl_GlobalInvocationID.x >= outputSize.x || gl_GlobalInvocationID.y >= outputSize.y) {
		return;
	}

    // 立体角的单位
	vec2 inputSize = vec2(textureSize(inputTexture, 0));
	float wt = 4.0 * PI / (6 * inputSize.x * inputSize.y);

    // 直接把视线当作物品的法线反向，掠角的点可能表现不太好
	vec3 N = getSamplingVector();
	vec3 Lo = N;

	vec3 S, T;
	computeBasisVectors(N, S, T);

    vec3 color = vec3(0);
	float weight = 0;

    // 重要性采样GGX来做prefilter
    for(uint i=0; i<NumSamples; ++i) 
    {
        vec2 u = sampleHammersley(i);
		vec3 Lh = tangentToWorld(sampleGGX(u.x, u.y, PARAM_ROUGHNESS), N, S, T); // 半程向量采样方向，符合GGX分布（高光波瓣中的某一条光线）

        // 反射向量
        vec3 Li = 2.0 * dot(Lo, Lh) * Lh - Lo; // 视角反射方向

        // Cosθ
        float cosLi = dot(N, Li); // N * wi
        if(cosLi > 0.0)
        {
            // N * wo
            float cosLh = max(dot(N, Lh), 0.0);

            //GGX的pdf 
            float pdf = ndfGGX(cosLh, PARAM_ROUGHNESS) * 0.25;

            float ws = 1.0 / (NumSamples * pdf);//带权重要性采样，结果是“有偏”的！

            float mipLevels = max(0.5 * log2(ws / wt) + 1.0 , 0.0); // 大手子提出可以提前滤波，因为越粗糙，光线的波瓣会越大
            color += textureLod(inputTexture,Li,mipLevels).rgb * cosLi;
            weight += cosLi;
        }
    }

    color /= weight;

    imageStore(outputTexture[PARAM_LEVEL], ivec3(gl_GlobalInvocationID), vec4(color, 1.0));
}